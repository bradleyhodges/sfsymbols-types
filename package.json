{
    "name": "@bradleyhodges/sfsymbols-types",
    "description": "Types for @bradleyhodges/sfsymbols-* packages.",
    "version": "8.1.3",
    "main": "dist/main/index.js",
    "module": "dist/module/index.js",
    "scripts": {
        "build": "rimraf ./dist && tsc && tsc && tsc -p tsconfig.main.json",
        "pub": "pnpm format && npm publish --access public --no-git-checks",
        "bump-deps": "npx npm-check-updates --deep -u \\!@biomejs/biome && pnpm up --latest --recursive && pnpm run format",
        "format": "biome check . --write --skip-errors",
        "clean": "git clean -xdf .cache .turbo node_modules -f",
        "typecheck": "tsc --noEmit --emitDeclarationOnly false"
    },
    "exports": {
        ".": {
            "import": "./dist/module/index.js",
            "require": "./dist/main/index.js"
        }
    },
    "repository": "https://github.com/bradleyhodges/sfsymbols-types",
    "bugs": {
        "url": "https://github.com/bradleyhodges/sfsymbols-types/issues"
    },
    "author": "Bradley Hodges",
    "devDependencies": {
        "@biomejs/biome": "1.9.4",
        "@types/node": "26.4.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "19.2.7",
        "react": "^19.2.8",
        "rimraf": "^6.1.3",
        "typescript": "^7.0.2"
    }
}
